# Docker Compose database connection. Running the API directly uses SQLite by default.
TRUSTTRACE_DATABASE_URL=postgresql+psycopg://trusttrace:trusttrace_local@postgres:5432/trusttrace

# Replace these values outside local development.
TRUSTTRACE_INGEST_API_KEY=tt_demo_ingest_change_me
TRUSTTRACE_ADMIN_API_KEY=tt_demo_admin_change_me
TRUSTTRACE_APP_ENV=development
TRUSTTRACE_PUBLIC_DEMO_READS=true
TRUSTTRACE_SEED_DEMO_DATA=true

# Comma-separated browser origins allowed to call the API.
TRUSTTRACE_CORS_ORIGINS=http://localhost:3000

# For non-Docker frontend development, copy web/.env.example to web/.env.local.
